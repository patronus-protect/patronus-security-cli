{
  "mcpServers": {
    "patronus-api": {
      "url": "https://control.patronus.studio/api/mcp"
    },
    "patronus": {
      "command": "node",
      "args": [
        "scripts/patronus.mjs",
        "mcp"
      ],
      "cwd": ".",
      "default_tools_approval_mode": "approve",
      "tools": {
        "patronus_reveal_pii": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
