    {
      "id": "consumer",
      "name": "LLM Input Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { llm_input: item.json.text, patronus: item.json.patronus } }));"
      }
