    "RAG / Prompt Text": {
      "main": [
        [
          {
            "node": "Patronus Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Patronus Guard": {
      "main": [
        [
          {
            "node": "LLM Input Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
