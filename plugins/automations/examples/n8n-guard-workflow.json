      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "text",
              "name": "text",
              "value": "Das Meeting beginnt morgen um 10 Uhr.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "guard",
      "name": "Patronus Guard",
      "type": "n8n-nodes-patronus.patronus",
